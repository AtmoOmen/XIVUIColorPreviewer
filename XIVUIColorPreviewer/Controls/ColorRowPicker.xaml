<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XIVUIColorPreviewer.Controls.ColorRowPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*,Auto,Auto">
        <ComboBox x:Name="RowComboBox"
                  Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="RowComboBox_SelectionChanged" />

        <Button x:Name="UpButton"
                Grid.Column="1"
                Content="&#xE70E;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Click="UpButton_Click"
                Margin="4,0,0,0"
                Padding="8,6"
                ToolTipService.ToolTip="上一个" />

        <Button x:Name="DownButton"
                Grid.Column="2"
                Content="&#xE70D;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Click="DownButton_Click"
                Margin="4,0,0,0"
                Padding="8,6"
                ToolTipService.ToolTip="下一个" />
    </Grid>
</UserControl>
