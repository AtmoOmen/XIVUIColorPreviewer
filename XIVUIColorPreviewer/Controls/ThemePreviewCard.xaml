<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="XIVUIColorPreviewer.Controls.ThemePreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Theme name label -->
        <TextBlock x:Name="ThemeNameText"
                   Grid.Row="0"
                   FontSize="12"
                   Opacity="0.7"
                   Margin="0,0,0,4" />

        <!-- Preview area: background image with text overlaid -->
        <Border Grid.Row="1"
                CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid x:Name="PreviewGrid">
                <!-- Background image, fills entire area -->
                <Image x:Name="BackgroundImage"
                       Stretch="Fill" />

                <!-- Text content stacked vertically, centered -->
                <StackPanel x:Name="TextStackPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
